# Agent Cost Monitor Environment Configuration

# Database (optional — defaults to SQLite at ./agent_monitor.db)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_monitor
DATABASE_URL=sqlite:///./agent_monitor.db

# API Key Authentication (optional — leave empty for local development mode)
# API_KEY=sk-live-agent-cost-monitor-secret-key
API_KEY=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default crew budget in USD
CREW_BUDGET_DEFAULT=5.00

# Optional integration keys
OPENAI_API_KEY=not-needed-for-simulator
